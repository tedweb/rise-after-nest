---
type Props = { variant: 'editorial' | 'postcards' | 'cinema' | 'guide' };
const {variant} = Astro.props;
const socials = [
  {name:'Instagram', href:'https://www.instagram.com/riseafternest?stkn=MW96YW1tMWMya3d0cA%3D%3D&utm_source=qr', path:'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.5-3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z'},
  {name:'Facebook', href:'https://www.facebook.com/share/1JafqwD9PU/?mibextid=wwXIfr', path:'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.3.2 2.3.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.8l-.5 2.9h-2.3v7A10 10 0 0 0 22 12Z'},
  {name:'YouTube', href:'https://www.youtube.com/@RiseAfterNest', path:'M21.6 7.2a2.8 2.8 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.6.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2 12a29 29 0 0 0 .4 4.8 2.8 2.8 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.8 2.8 0 0 0 2-2A29 29 0 0 0 22 12a29 29 0 0 0-.4-4.8ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z'},
  {name:'TikTok', href:'https://www.tiktok.com/@riseafternest?_r=1&_t=ZP-99p0SdKEn9y', path:'M16.7 2h-3.4v13.7a2.9 2.9 0 1 1-2.5-2.9V9.3a6.4 6.4 0 1 0 6 6.4V8.8a8.3 8.3 0 0 0 4.8 1.5V6.9A5 5 0 0 1 16.7 2Z'},
];
---
<nav class:list={['design-socials', variant]} aria-label="Social media">
  {socials.map(social => <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${social.name} (opens in a new tab)`} title={social.name}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d={social.path}/></svg></a>)}
</nav>
<style>
  .design-socials{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .design-socials a{width:40px;height:40px;display:grid;place-items:center;border:1px solid currentColor;border-radius:50%;color:inherit;transition:transform .15s,background-color .15s}
  svg{fill:currentColor;display:block}
  .design-socials a:hover{transform:translateY(-3px);background:#ffffff20}
  .design-socials a:focus-visible{outline:3px solid #9575ed;outline-offset:4px}
  .editorial a{border-color:#333c3340}
  .postcards a{background:#fff7e6;color:#263e38;border:0;box-shadow:2px 2px 0 #f2c655;border-radius:9px}
  .postcards a:hover{background:#f2c655;transform:rotate(-6deg)}
  .cinema a{color:#d7ee93;border-color:#d7ee9340;border-radius:0}
  .guide a{background:#ffffff12;border-color:#ffffff30;border-radius:8px}
  .guide a:hover{background:#d5ef7a;color:#193e39}
  @media(prefers-reduced-motion:reduce){.design-socials a{transition:none}.design-socials a:hover{transform:none}}
</style>
