---
import DesignSocialLinks from '../components/DesignSocialLinks.astro';
const photos = {
  coast: 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=1800&q=85',
  town: 'https://images.unsplash.com/photo-1516483638261-f4dbaf036963?auto=format&fit=crop&w=1000&q=85',
  road: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1600&q=85',
  beach: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=85',
};
const directions = [
  {id:'editorial', number:'01', name:'The Sunday Edit', mood:'Considered · literary · timeless', detail:'A travel magazine worth lingering over. Generous white space, expressive serif type, and photography that gives every story room to breathe.'},
  {id:'postcards', number:'02', name:'Wish You Were Here', mood:'Warm · spontaneous · personal', detail:'A scrapbook of a life well traveled. Handwritten touches, cheerful color, and collected moments put Doug and Tara’s personalities first.'},
  {id:'cinema', number:'03', name:'The Wide Open', mood:'Immersive · bold · atmospheric', detail:'An invitation to somewhere new. Full-bleed scenery, oversized headlines, and a film-inspired layout make photos and video the main event.'},
  {id:'guide', number:'04', name:'Good Company', mood:'Useful · friendly · confident', detail:'The travel friend who tells you everything. Clear categories, accessible reviews, and easy-to-find advice help readers plan their own next chapter.'},
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Rise After Nest — Design decisions</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&family=Space+Grotesk:wght@400;500;600;700&family=Caveat:wght@500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="review-header">
    <a class="review-brand" href="#">RAN <span>/ DESIGN STUDIO</span></a><span class="review-status">DESIGN DECISIONS / A LIVING RECORD</span>
  </header>
  <main>
    <section class="review-intro">
      <p class="eyebrow">RISE AFTER NEST / A VISUAL EXPLORATION</p>
      <h1>Where shall we take this?</h1>
      <p>The current homepage plus four possible directions for what comes next. This page is a running record of the decisions we make together.</p>
    </section>
    <nav class="direction-tabs" aria-label="Design directions">
      <a href="#current" data-direction="current"><span>00</span>Current homepage<b>↗</b></a>
      {directions.map(d => <a href={`#${d.id}`} data-direction={d.id}><span>{d.number}</span>{d.name}<b>↗</b></a>)}
    </nav>
    <p class="sample-note">DESIGN DECISIONS · The current homepage appears live below. The four concepts use sample travel photography and illustrative headlines until they are adapted with your photos and stories.</p>

    <section id="current" class="direction current-direction">
      <header class="direction-heading"><div><span>00 / CURRENT HOMEPAGE</span><h2>The site as it is today.</h2></div><p>This is the live homepage, included as the baseline for every design conversation. It updates automatically when the published homepage changes.<small>LIVE · CURRENT · REFERENCE</small></p></header>
      <div class="current-browser">
        <div class="current-browser-bar"><span></span><span></span><span></span><strong>riseafternest.com</strong><a href="https://riseafternest.com/" target="_blank" rel="noopener noreferrer">Open full page ↗</a></div>
        <iframe src="https://riseafternest.com/" title="Current Rise After Nest homepage"></iframe>
      </div>
    </section>

    <section id="editorial" class="direction">
      <header class="direction-heading"><div><span>01 / THE SUNDAY EDIT</span><h2>A little more room to wander.</h2></div><p>{directions[0].detail}<small>{directions[0].mood}</small></p></header>
      <div class="mock editorial">
        <div class="e-top"><span>TRAVEL. TOGETHER.</span><span>NOTES FROM OUR NEXT CHAPTER</span></div>
        <div class="e-masthead">Rise <i>after</i> Nest<span>EST. A NEW CHAPTER</span></div>
        <nav class="mock-nav"><a href="#e-stories">The journal</a><a href="#e-stories">Places & stays</a><a href="#e-about">Our story</a><a href="#feedback">Say hello ↗</a></nav>
        <div class="e-hero"><div><p class="eyebrow">THE WORLD IS STILL WAITING</p><h3>The nest is empty.<br/>Our days are<br/><i>anything but.</i></h3><p>We’re Doug & Tara. Finding new favorite places, taking the scenic route, and making this chapter our own.</p><a class="text-link" href="#e-stories">Come along for the story <span>↗</span></a></div><figure><img src={photos.coast} alt="Lakeside village and mountains, sample travel photography" /><figcaption>01 — Somewhere worth slowing down for.</figcaption></figure></div>
        <div class="e-section-title" id="e-stories"><h4>The latest pages</h4><span>A FEW THINGS TO WRITE HOME ABOUT</span></div>
        <div class="e-cards"><article><img src={photos.beach} alt="Palm-lined beach" loading="lazy"/><p class="eyebrow">PLACES & STAYS / FLORIDA</p><h4>A little time in Key Largo</h4><p>Our Amoray stay, on land and below the surface.</p><a href="https://www.youtube.com/watch?v=mUzeW4B3vH8" target="_blank" rel="noreferrer">Watch our trip ↗</a></article><article><img src={photos.town} alt="Colorful coastal village" loading="lazy"/><p class="eyebrow">THE SCENIC ROUTE / SAMPLE STORY</p><h4>No plans until lunch</h4><p>On leaving room for the best kind of detour.</p></article><article class="e-note" id="e-about"><span>A NOTE FROM US</span><h4>More time.<br/>More possibility.<br/><i>More us.</i></h4><p>The kids have their adventures. These are ours. We’re glad you’re here for them.</p><span class="signature">Doug & Tara</span></article></div>
        <footer class="e-footer">Rise after Nest <span>Stories from a life still unfolding.</span><DesignSocialLinks variant="editorial" /></footer>
      </div>
    </section>

    <section id="postcards" class="direction">
      <header class="direction-heading"><div><span>02 / WISH YOU WERE HERE</span><h2>Life looks good from here.</h2></div><p>{directions[1].detail}<small>{directions[1].mood}</small></p></header>
      <div class="mock postcards">
        <nav class="p-nav"><a class="p-brand" href="#postcards">rise after nest<span>✳</span></a><div><a href="#p-stories">Our adventures</a><a href="#p-about">Hi, we’re us!</a><a class="p-pill" href="#feedback">Drop us a note ↗</a></div></nav>
        <div class="p-hero"><div class="p-copy"><span class="handwritten">Two tickets to whatever’s next.</span><h3>Grown kids.<br/>Big world.<br/><em>Let’s go!</em></h3><p>We’re Doug & Tara, collecting little adventures, great meals, and “remember when?” moments.</p><a class="p-button" href="#p-stories">Open our travel scrapbook ↗</a><span class="p-doodle">less routine, more “why not?” ⤴</span></div><div class="p-collage"><span class="p-stamp">NEXT CHAPTER<br/>✳<br/>POSTAGE PAID</span><figure class="polaroid p-one"><img src={photos.town} alt="Colorful buildings above a Mediterranean harbor"/><figcaption>Taking the long way ♡</figcaption></figure><figure class="polaroid p-two"><img src={photos.beach} alt="A sandy beach with turquoise water"/><figcaption>Out of office. Into this.</figcaption></figure><span class="p-sticker">GOOD<br/>DAYS<br/>AHEAD</span></div></div>
        <div class="p-ticker" aria-hidden="true">NEW PLACES ✳ LITTLE JOYS ✳ GOOD FOOD ✳ TOGETHER TIME ✳ NEW PLACES ✳ LITTLE JOYS</div>
        <div id="p-stories" class="p-stories"><header><span class="handwritten">Fresh from the scrapbook</span><h4>Oh, the places we’ll go.</h4></header><div class="p-card-grid"><article class="p-card"><img src={photos.beach} alt="Beach view, illustrative Key Largo card" loading="lazy"/><span class="p-tag">FLORIDA FILES</span><h5>Checking in, chilling out.</h5><p>Our honest Amoray Dive Resort review.</p><a href="https://www.youtube.com/watch?v=mUzeW4B3vH8" target="_blank" rel="noreferrer">Watch our Key Largo adventure ↗</a></article><article class="p-card yellow" id="p-about"><span class="handwritten">A new kind of family album</span><h5>Same us.<br/>New adventures.</h5><p>For years, life revolved around the nest. Now we’re finding out what happens when we spread our wings, too.</p><span class="handwritten">See you out there!<br/>Doug + Tara ♡</span></article><article class="p-card"><img src={photos.road} alt="Mountain landscape" loading="lazy"/><span class="p-tag">SAMPLE STORY</span><h5>Worth the scenic route.</h5><p>Sometimes the best part isn’t the destination.</p></article></div></div>
        <footer class="p-footer">Sent with love, from somewhere new. <span>Doug + Tara ↗</span><DesignSocialLinks variant="postcards" /></footer>
      </div>
    </section>

    <section id="cinema" class="direction">
      <header class="direction-heading"><div><span>03 / THE WIDE OPEN</span><h2>Make the next chapter a big one.</h2></div><p>{directions[2].detail}<small>{directions[2].mood}</small></p></header>
      <div class="mock cinema">
        <div class="c-hero"><img class="c-background" src={photos.road} alt="Dramatic mountain peaks at dusk" loading="lazy"/><nav class="c-nav"><a class="c-logo" href="#cinema">RISE<br/><span>AFTER NEST ↗</span></a><div><a href="#c-stories">JOURNAL</a><a href="#c-film">FILMS</a><a href="#c-about">OUR STORY</a></div><span class="c-cross">✳</span></nav><div class="c-hero-copy"><p class="eyebrow">DOUG & TARA / THE NEXT CHAPTER</p><h3>THERE’S<br/>MORE<br/><em>OUT THERE.</em></h3><div><p>New horizons. Shared stories.<br/>A life with room for the unexpected.</p><a href="#c-stories">EXPLORE WITH US <span>↘</span></a></div></div><div class="c-bottom"><span>01 / A WORLD OF POSSIBILITY</span><span>SCROLL TO DISCOVER ↓</span></div></div>
        <div class="c-intro" id="c-about"><span>THE REASON WE GO</span><h4>We’ve raised a family.<br/>Now we’re raising<br/><em>our sense of wonder.</em></h4><p>Rise After Nest is our journal of what comes next: places that move us, stays worth sharing, and the simple joy of seeing it all together.</p></div>
        <div class="c-stories" id="c-stories"><header><h4>FIELD NOTES</h4><span>STORIES / STAYS / FILMS</span></header><div class="c-grid"><article id="c-film"><img src={photos.beach} alt="Sunlit tropical beach" loading="lazy"/><div><span>FILM 001 / KEY LARGO</span><h5>A different kind<br/>of blue.</h5><a href="https://www.youtube.com/watch?v=mUzeW4B3vH8" target="_blank" rel="noreferrer">▶ WATCH THE AMORAY REVIEW</a></div></article><article><img src={photos.coast} alt="Mountain lake beside a village" loading="lazy"/><div><span>SAMPLE STORY / SLOW TRAVEL</span><h5>Stay a<br/>little longer.</h5><p>Some places ask you to pause.</p></div></article></div></div>
        <footer class="c-footer">THE NEST IS EMPTY. <span>THE WORLD ISN’T. ↗</span><DesignSocialLinks variant="cinema" /></footer>
      </div>
    </section>

    <section id="guide" class="direction">
      <header class="direction-heading"><div><span>04 / GOOD COMPANY</span><h2>Your next trip starts with a friend.</h2></div><p>{directions[3].detail}<small>{directions[3].mood}</small></p></header>
      <div class="mock guide">
        <nav class="g-nav"><a class="g-brand" href="#guide"><span>↗</span>rise after nest<span class="g-dot">.</span></a><div><a href="#g-stories">Explore</a><a href="#g-review">Rise Reviews</a><a href="#g-about">Meet Doug & Tara</a></div><a class="g-nav-cta" href="#g-stories">Find your next trip ↗</a></nav>
        <div class="g-hero"><div><p class="g-kicker"><span></span> GOOD PLACES. HONEST TAKES. GREAT COMPANY.</p><h3>A new chapter.<br/>A whole world<br/>of <em>possibilities.</em></h3><p>Travel stories and straight-up reviews from two empty nesters making the most of what’s next.</p><a class="g-button" href="#g-stories">Let’s find your next adventure ↗</a><div class="g-byline"><span>D + T</span><p>Your travel companions,<br/><strong>Doug & Tara Markott</strong></p></div></div><div class="g-hero-photo"><img src={photos.town} alt="Coastal town and colorful buildings" loading="lazy"/><div class="g-photo-label"><span>THE NEXT CHAPTER CLUB</span><b>More “let’s go.”<br/>Less “one day.”</b><span>↗</span></div></div></div>
        <div class="g-categories" aria-label="Explore by interest"><span>WHAT’S YOUR KIND OF GETAWAY?</span><a href="#g-review">⌂ &nbsp; Memorable stays ↗</a><a href="#g-stories">☀ &nbsp; Places to explore ↗</a><a href="#g-review">▷ &nbsp; Travel videos ↗</a></div>
        <div class="g-content" id="g-stories"><header><div><p class="eyebrow">TRIED IT. LIVED IT. SHARING IT.</p><h4>A little inspiration for your itinerary.</h4></div></header><div class="g-content-grid"><article class="g-feature" id="g-review"><img src={photos.beach} alt="Tropical beach, sample resort review photography" loading="lazy"/><div><span class="g-badge">RISE REVIEW</span><span class="g-location">KEY LARGO, FLORIDA</span><h5>Amoray Dive Resort:<br/>hero or zero?</h5><p>Our look at the stay, the staff, and the experience—plus a little adventure under the surface.</p><a href="https://www.youtube.com/watch?v=mUzeW4B3vH8" target="_blank" rel="noreferrer">Watch our honest review <span>↗</span></a></div></article><aside id="g-about"><span class="g-aside-icon">✳</span><p class="eyebrow">HI, WE’RE DOUG & TARA</p><h5>Your next chapter<br/>can be your best yet.</h5><p>We’re figuring it out one getaway at a time. Join us for the places we love and the honest details that help you decide.</p><strong>Here’s to what’s next. ↗</strong></aside></div></div>
        <footer class="g-footer"><strong>rise after nest.</strong><span>Go somewhere good. Come home with a story.</span><DesignSocialLinks variant="guide" /></footer>
      </div>
    </section>

    <section class="feedback" id="feedback"><div><p class="eyebrow">YOUR TURN</p><h2>What feels like you?</h2><p>You don’t have to choose a whole design. “The type from 01, the warmth of 02, and the reviews from 04” is useful feedback, too.</p><p class="privacy-note">Notes stay in this browser when storage is available. Download them to share with Ted; nothing is sent automatically.</p></div><form id="feedback-form"><label for="favorite">The direction I’m leaning toward</label><select id="favorite" name="favorite"><option value="Still exploring">Still exploring</option><option>01 — The Sunday Edit</option><option>02 — Wish You Were Here</option><option>03 — The Wide Open</option><option>04 — Good Company</option><option>A mix of directions</option></select><label for="notes">What you love, what you’d change, what feels missing</label><textarea id="notes" name="notes" rows="5" placeholder="I love… / I’d rather… / It should feel more…"></textarea><button type="submit">Download my feedback ↗</button><p id="feedback-status" role="status"></p></form></section>
  </main>
  <footer class="review-footer">RISE AFTER NEST <span>FOUR POSSIBLE BEGINNINGS / DESIGN REVIEW</span><a href="#">Back to top ↑</a></footer>
</body>
</html>

<script>
  const form = document.querySelector<HTMLFormElement>('#feedback-form');
  const favorite = document.querySelector<HTMLSelectElement>('#favorite');
  const notes = document.querySelector<HTMLTextAreaElement>('#notes');
  if (form && favorite && notes) {
    try { const saved = JSON.parse(localStorage.getItem('ran-design-feedback') || 'null'); if(saved) { favorite.value = saved.favorite; notes.value = saved.notes; } } catch {}
    form.addEventListener('input', () => { try { localStorage.setItem('ran-design-feedback', JSON.stringify({favorite:favorite.value, notes:notes.value})); } catch {} });
    form.addEventListener('submit', event => {
      event.preventDefault();
      const blob = new Blob([`Rise After Nest — Design feedback\n\nPreferred direction: ${favorite.value}\n\nNotes:\n${notes.value || '(No notes yet)'}\n`], {type:'text/plain;charset=utf-8'});
      const url = URL.createObjectURL(blob); const link = document.createElement('a'); link.href=url; link.download='rise-after-nest-design-feedback.txt'; link.click(); setTimeout(()=>URL.revokeObjectURL(url), 1000);
      const status = document.querySelector('#feedback-status'); if(status) status.textContent='Feedback file prepared. Share the downloaded file with Ted.';
    });
  }
  const observer = new IntersectionObserver(entries => { entries.forEach(entry => {if(entry.isIntersecting) { document.querySelectorAll('[data-direction]').forEach(link => { if(link.getAttribute('data-direction')===entry.target.id) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); }); }}); }, {rootMargin:'-15% 0px -65% 0px'});
  document.querySelectorAll('.direction').forEach(section=>observer.observe(section));
</script>

<style is:global>
  .mock footer{flex-wrap:wrap;gap:20px;align-items:center}.mock footer .design-socials{font-family:'DM Sans',sans-serif;background:none;padding:0}
  .direction-tabs{grid-template-columns:repeat(5,1fr)}.current-browser{background:#fff;border:1px solid #c9cbd3;box-shadow:0 14px 50px #2324330d;overflow:hidden}.current-browser-bar{height:46px;background:#30313a;color:#fff;display:flex;align-items:center;gap:7px;padding:0 15px;font-size:10px}.current-browser-bar>span{width:8px;height:8px;border-radius:50%;background:#858691}.current-browser-bar>span:first-child{background:#ec6d64}.current-browser-bar>span:nth-child(2){background:#e8c85b}.current-browser-bar>span:nth-child(3){background:#66bd7a}.current-browser-bar strong{font-weight:500;letter-spacing:.5px;margin-left:10px}.current-browser-bar a{margin-left:auto;border:1px solid #ffffff50;border-radius:4px;padding:7px 10px;font-size:9px}.current-browser iframe{display:block;width:100%;height:770px;border:0;background:#fff}
  *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;color:#24262b;background:#eeeef1;font-family:'DM Sans',sans-serif}a{color:inherit;text-decoration:none}button,select,textarea{font:inherit}a,button,select,textarea{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #9673ff;outline-offset:5px}img{display:block;width:100%;height:100%;object-fit:cover}h1,h2,h3,h4,h5,p,figure{margin:0}a:hover{text-decoration:underline;text-underline-offset:5px}.review-header{padding:23px 4%;display:flex;justify-content:space-between;border-bottom:1px solid #d4d4dc;font-size:11px;letter-spacing:1.5px}.review-brand{font-weight:700;font-size:17px}.review-brand span{font-size:10px;margin-left:15px;font-weight:500}.review-status{padding-top:4px}.review-intro{padding:64px 4% 36px}.eyebrow{font-size:10px;font-weight:700;letter-spacing:1.8px;line-height:1.5}.review-intro h1{font-size:clamp(36px,4.8vw,64px);font-weight:500;letter-spacing:-3px;margin:13px 0}.review-intro>p:last-child{font-size:16px;color:#666772;line-height:1.7}.direction-tabs{position:sticky;top:0;z-index:10;background:#eeeef1ed;backdrop-filter:blur(15px);padding:12px 4%;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;border-bottom:1px solid #d4d4dc}.direction-tabs a{padding:17px 14px;background:#fff;border:1px solid #d9d9e1;font-size:12px;border-radius:5px;display:flex;align-items:center;gap:10px}.direction-tabs a[aria-current]{background:#252730;color:white;border-color:#252730}.direction-tabs span{font-size:10px;opacity:.6}.direction-tabs b{margin-left:auto}.sample-note{font-size:10px;line-height:1.7;color:#71717c;padding:18px 4%;letter-spacing:.3px}.direction{padding:48px 4% 20px}.direction-heading{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;margin-bottom:25px}.direction-heading>div>span{font-size:10px;letter-spacing:2px;font-weight:700}.direction-heading h2{font-s