---
const concepts = [
  {slug: "the-itinerary", number: "01", name: "The Itinerary", note: "Quiet luxury / travel magazine"},
  {slug: "postcard-club", number: "02", name: "Postcard Club", note: "Sunlit, playful, collected"},
  {slug: "after-dark", number: "03", name: "After Dark", note: "Cinematic / editorial journal"},
  {slug: "field-notes", number: "04", name: "Field Notes", note: "Graphic, energetic, guidebook"},
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Rise After Nest — UI concepts</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">RISE AFTER NEST / CUSTOMER REVIEW</p>
      <h1>Four ways the next chapter could look.</h1>
      <p class="intro">Each direction is a working Astro page, designed to make the visual conversation concrete. Choose what feels most like Doug and Tara—or mix the pieces you love.</p>
      <section class="grid" aria-label="Design directions">
        {concepts.map((concept) => <a href={`/ui-concepts/${concept.slug}/`}><span>{concept.number}</span><h2>{concept.name}</h2><p>{concept.note}</p><b>Open direction ↗</b></a>)}
      </section>
    </main>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono&family=DM+Sans:wght@400;500;700&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap');
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#f0eee6;color:#1e2927;font-family:"DM Sans",sans-serif}main{max-width:1100px;margin:auto;padding:10vh 6vw}.eyebrow{font:12px "DM Mono",monospace;letter-spacing:.12em;color:#ac4f3e}h1{font:800 clamp(3.4rem,8vw,7rem)/.92 "Playfair Display",serif;max-width:850px;margin:.45em 0}.intro{font-size:1.15rem;line-height:1.6;max-width:650px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:4rem}.grid a{padding:2rem;min-height:230px;color:inherit;text-decoration:none;border:1px solid #1e2927;display:flex;flex-direction:column;transition:transform .2s}.grid a:nth-child(1){background:#d7dfd9}.grid a:nth-child(2){background:#f6cf55}.grid a:nth-child(3){background:#1e2927;color:#f2eee2}.grid a:nth-child(4){background:#f6aa89}.grid a:hover{transform:translate(-5px,-5px);box-shadow:5px 5px #1e2927}.grid span{font:12px "DM Mono",monospace}.grid h2{font:800 2.4rem "Playfair Display",serif;margin:auto 0 .15em}.grid p{margin:0}.grid b{margin-top:1.5rem;font-size:.85rem}@media(max-width:650px){.grid{grid-template-columns:1fr}main{padding-top:7vh}}
</style>
