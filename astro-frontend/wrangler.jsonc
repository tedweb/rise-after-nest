{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rise-after-nest",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "riseafternest.com",
      "custom_domain": true
    }
  ]
}
